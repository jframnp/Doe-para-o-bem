PORT=3333

# Troque por um valor longo e aleatório em produção
JWT_SECRET=troque-este-segredo

# "memory" roda sem banco (ótimo para desenvolvimento e testes)
# "postgres" usa o DATABASE_URL abaixo (suba o banco com docker compose up -d)
DB_DRIVER=memory
DATABASE_URL=postgres://dpb:dpb@localhost:5432/dpb

# Diretório local das imagens (substituível por S3/Cloudinary)
UPLOAD_DIR=uploads
